# ============================================================================
# TROPICAL_GRID_6X5_95_10K - Variables de entorno
# Copiar a ".env" y completar. NUNCA subir ".env" al repositorio.
# ============================================================================

# --- Servidor HTTP -----------------------------------------------------------
PORT=3000
NODE_ENV=development
# Origenes permitidos por CORS, separados por coma. En produccion usar el
# dominio real del front-end (ej: https://juego.tudominio.com)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Supabase (SOLO BACKEND) -------------------------------------------------
# URL del proyecto (Settings > API)
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# Clave "service_role". NUNCA debe llegar al navegador. Salta RLS por diseno.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9....

# --- Seguridad de sesion -----------------------------------------------------
# Secreto HMAC de 64 caracteres hex para firmar los tokens de sesion.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=cambia_este_secreto_por_uno_de_64_caracteres_hexadecimales
SESSION_TTL_SECONDS=3600

# --- Modo demo ---------------------------------------------------------------
# true  -> habilita POST /api/session (emite tokens sin validar PIN).
# false -> OBLIGATORIO en produccion. El token debe venir de tu IdP/Auth.
ALLOW_DEV_SESSION=true
# Jugador demo creado por "npm run seed"
DEV_DEMO_PLAYER_ID=00000000-0000-4000-8000-000000000001

# --- Fichas de Prueba (Jugar Gratis) -----------------------------------------
# Habilita POST /api/demo/session y las rondas de invitado (`invitado_demo`).
# IMPORTANTE: el saldo es VIRTUAL (memoria del proceso) y NUNCA se escribe en
# Supabase. Reiniciar el servidor devuelve a todos los invitados a 1.000,00.
# Ponlo en false para ocultar/desactivar el modo demo.
DEMO_MODE_ENABLED=true
DEMO_GUEST_ID=invitado_demo
DEMO_GUEST_NAME=Invitado Demo
DEMO_CURRENCY=VES
# Saldo inicial en centimos: 100000 = 1.000,00
DEMO_START_BALANCE_CENTS=100000
# Expiracion deslizante de la cartera virtual y vida del token demo
DEMO_SESSION_TTL_MS=1800000
DEMO_TOKEN_TTL_SECONDS=7200
# Limites de memoria y de idempotencia por invitado
# (5 rondas bastan para reintentos; cada ronda guarda el resultado completo)
DEMO_MAX_SESSIONS=2000
DEMO_MAX_IDEMPOTENT_ROUNDS=5

# --- Limites de juego --------------------------------------------------------
# Multiplicador maximo de exposicion por ronda (fijado por el informe: 10.000x)
MAX_EXPOSURE_MULTIPLIER=10000
# Limite de peticiones por jugador (ventana deslizante en memoria)
RATE_LIMIT_WINDOW_MS=1000
RATE_LIMIT_MAX_REQUESTS=12
